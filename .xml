<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Glassmorphism Particle Hero</title>
  <style>
    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      font-family: 'Poppins', sans-serif;
      overflow: hidden;
    }
    #particles-js {
      position: absolute;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #1f1c2c, #928dab);
      z-index: -1;
    }
    .hero {
      position: relative;
      width: 80%;
      max-width: 800px;
      margin: auto;
      padding: 40px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
      text-align: center;
      color: #fff;
      z-index: 1;
      animation: fadeIn 2s ease;
    }
    .hero h1 {
      font-size: 3rem;
      margin-bottom: 20px;
    }
    .hero p {
      font-size: 1.2rem;
      margin-bottom: 30px;
    }
    .hero button {
      padding: 12px 30px;
      border: none;
      border-radius: 30px;
      background: rgba(255, 255, 255, 0.3);
      color: #fff;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .hero button:hover {
      background: rgba(255, 255, 255, 0.6);
      color: #333;
      transform: scale(1.1);
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(50px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
  <!-- Particle Background -->
  <div id="particles-js"></div>

  <!-- Glassmorphism Hero -->
  <section class="hero">
    <h1>Welcome to Glass Particle World</h1>
    <p>Frosted glass meets animated particles</p>
    <button onclick="showMessage()">Explore Now</button>
  </section>

  <!-- Particle.js Script -->
  <script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>
  <script>
    particlesJS("particles-js", {
      particles: {
        number: { value: 100 },
        size: { value: 3 },
        move: { speed: 2 },
        line_linked: { enable: true, distance: 150, color: "#ffffff" },
        color: { value: "#ffffff" }
      }
    });

    function showMessage() {
      alert("✨ Glass + Particle magic activated!");
    }
  </script>
</body>
</html>
